{
  "routes": [
    {
      "route": "/downloads/*",
      "headers": {
        "Content-Disposition": "attachment",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".apk": "application/vnd.android.package-archive",
    ".sha256": "text/plain"
  }
}
