# For a separately hosted API, set this before npm run build (no trailing /api).
VITE_API_BASE_URL=https://your-api.azurewebsites.net
# Development defaults to https://localhost:7180.
# Production without this variable uses /api on the PWA origin.

# Optional footer links. Leave blank to hide them in another deployment.
VITE_GITHUB_URL=
VITE_ANDROID_APK_URL=
# For a locally hosted APK, use a versioned URL such as /downloads/App-1.0.0.apk
# and set the local source file below. This path is used only while building.
AFTERTAB_ANDROID_APK_PATH=

# Optional Android website association, generated into dist/.well-known/assetlinks.json.
# Leave both blank for a deployment without an Android wrapper.
# Use your own package ID and comma-separated SHA-256 signing certificate fingerprints.
# These values become public in assetlinks.json; never provide a private key or password.
AFTERTAB_ANDROID_PACKAGE_ID=
AFTERTAB_ANDROID_CERT_SHA256=
