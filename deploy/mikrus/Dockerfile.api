FROM mcr.microsoft.com/dotnet/sdk:9.0 AS source
WORKDIR /src/after-tab-api
COPY after-tab-api/Directory.Build.props after-tab-api/Directory.Packages.props after-tab-api/NuGet.Config after-tab-api/global.json ./
COPY after-tab-api/src ./src
COPY after-tab-api/tools/AfterTab.Deployment ./tools/AfterTab.Deployment

FROM source AS api-build
RUN dotnet publish src/AfterTab.API/AfterTab.API.csproj -c Release -o /out

FROM source AS migration-build
RUN dotnet publish tools/AfterTab.Deployment/AfterTab.Deployment.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
RUN mkdir -p /app/logs /app/keys && chown -R app:app /app
USER app

FROM runtime AS migrate
COPY --from=migration-build /out ./
ENTRYPOINT ["dotnet", "AfterTab.Deployment.dll", "--migrate"]

FROM runtime AS api
COPY --from=api-build /out ./
EXPOSE 8080
ENTRYPOINT ["dotnet", "AfterTab.API.dll"]
