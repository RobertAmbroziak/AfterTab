# Copy to .env on your deployment machine. The real .env is ignored by Git.
# Set the public HTTPS origin, without a trailing slash or /api.
PUBLIC_ORIGIN=https://aftertab.example.com

# Required: generate TWO different passwords, e.g. openssl rand -hex 32.
# Hex passwords avoid connection-string and Compose interpolation delimiters.
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Default: only a reverse proxy running on the VPS can reach the frontend.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Change these together if this subnet is already used by another Docker stack.
DOCKER_SUBNET=172.30.37.0/24
DOCKER_GATEWAY=172.30.37.1
FRONTEND_IP=172.30.37.10
# Host proxy via Docker's gateway; for an external Mikrus proxy use its actual CIDR.
TRUSTED_PROXY_CIDR=172.30.37.1/32

# Optional: needed for registration / password-reset email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: configure callbacks for THIS deployment, not the Azure hostname.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional AI integration. Enables /mcp and the token panel when images are rebuilt.
MCP_ENABLED=false
