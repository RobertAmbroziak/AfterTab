# Copy this to .env on the VPS; never commit real secrets.
PUBLIC_API_ORIGIN=https://api.example.com
FRONTEND_ORIGIN=https://example.com

# Create a Cloudflare Tunnel and set its token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Generate two distinct values on the VPS with: openssl rand -hex 32
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

MCP_ENABLED=true

# Optional account email and social sign-in providers.
MAIL_HOST=
MAIL_PORT=587
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
