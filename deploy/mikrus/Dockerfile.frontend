FROM node:22-alpine AS build
WORKDIR /src/after-tab-app
COPY after-tab-app/package.json after-tab-app/package-lock.json ./
RUN npm ci
COPY after-tab-app/ ./
# A relative API URL keeps the image independent of any deployment hostname.
ENV VITE_API_BASE_URL=""
ARG VITE_MCP_ENABLED=false
ENV VITE_MCP_ENABLED=$VITE_MCP_ENABLED
RUN npm run build

FROM nginx:stable-alpine AS frontend
COPY deploy/mikrus/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/mikrus/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --from=build /src/after-tab-app/dist /usr/share/nginx/html
EXPOSE 8080
