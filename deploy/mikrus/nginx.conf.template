server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    access_log off;
    error_log /dev/stderr warn;
    client_max_body_size 1m;

    # Only this external/host proxy may supply the actual visitor's IP.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location /api/ {
        include /etc/nginx/api-proxy.conf;
    }
    location = /mcp {
        include /etc/nginx/api-proxy.conf;
        proxy_buffering off;
    }
    location /mcp/ {
        include /etc/nginx/api-proxy.conf;
        proxy_buffering off;
    }
    location = /signin-google {
        include /etc/nginx/api-proxy.conf;
    }
    location = /signin-facebook {
        include /etc/nginx/api-proxy.conf;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location /downloads/ {
        add_header Content-Disposition attachment;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    # The application uses hash routes. Missing files must remain real 404s.
    location / {
        try_files $uri $uri/ =404;
    }
}
