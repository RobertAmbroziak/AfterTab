FROM node:22-alpine AS build
WORKDIR /src/after-tab-app
COPY after-tab-app/package.json after-tab-app/package-lock.json ./
RUN npm ci
COPY after-tab-app/ ./
# A relative API URL keeps the image independent of any deployment hostname.
ENV VITE_API_BASE_URL=""
ARG VITE_MCP_ENABLED=false
ENV VITE_MCP_ENABLED=$VITE_MCP_ENABLED
ARG VITE_OPERATOR_NAME="Service operator"
ENV VITE_OPERATOR_NAME=$VITE_OPERATOR_NAME
ARG VITE_CONTACT_EMAIL=contact@example.com
ENV VITE_CONTACT_EMAIL=$VITE_CONTACT_EMAIL
ARG VITE_HOSTING_PROVIDER="hosting provider"
ENV VITE_HOSTING_PROVIDER=$VITE_HOSTING_PROVIDER
ARG VITE_EMAIL_PROVIDER="email provider"
ENV VITE_EMAIL_PROVIDER=$VITE_EMAIL_PROVIDER
RUN npm run build

FROM nginx:stable-alpine AS frontend
COPY deploy/vps/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/vps/api-proxy.conf /etc/nginx/api-proxy.conf
COPY --from=build /src/after-tab-app/dist /usr/share/nginx/html
EXPOSE 8080
